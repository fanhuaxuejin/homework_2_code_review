# 【必填】LLM API Key
# DeepSeek 平台： https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-请替换为你的真实Key

# 【可选】指定生效的 provider，取值见 config.py 中 PROVIDERS 的键
LLM_PROVIDER=deepseek

# 【可选】覆盖模型名。留空则使用 provider 的默认模型。
# 注意：模型名会变，用之前先查官方文档确认当前可用的是哪几个
LLM_MODEL=

# 【可选】思考模式开关
LLM_THINKING=1

# 【可选】单次调用超时（秒）与最大重试次数
LLM_TIMEOUT=120
LLM_MAX_RETRIES=4

# 【可选】允许 Agent 访问的根目录，默认当前工作目录
# AGENT_WORKSPACE=.

# 【可选】run_python 工具执行代码的超时（秒）
RUN_PYTHON_TIMEOUT=10

MAX_FIX_ROUNDS=2

NODE_RETRIES=2